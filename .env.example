# Application
APP_NAME=Enterprise AI Platform
APP_VERSION=0.1.0
API_PREFIX=/api/v1
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_ai

# File Upload
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE=52428800

# Vector Store (Milestone 2)
VECTOR_STORE_DIR=data/vector_store

# LLM (Milestone 3+)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4
# LLM_API_KEY=

# LLM Config
GEMINI_API_KEY=your_gemini_api_key_here
